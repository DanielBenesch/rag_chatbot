OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

CHROMA_HOST=localhost
CHROMA_PORT=8000

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ENABLED=true

# MLflow server (compose only). Empty allows localhost and the `mlflow` service name.
# To open the UI via a VPS IP or domain, e.g.:
# MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mlflow:*,203.0.113.10:5000
# MLFLOW_CORS_ALLOWED_ORIGINS=http://203.0.113.10:5000
MLFLOW_ALLOWED_HOSTS=
MLFLOW_CORS_ALLOWED_ORIGINS=
